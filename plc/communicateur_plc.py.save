# -*- coding: utf-8 -*-
import asyncio
import logging
from asyncua import Client

logger = logging.getLogger("CommunicateurPLC")

class CommunicateurPLC:
    def __init__(self, ip, port=4840):
        self.url = "opc.tcp://{}:{}".format(ip, port)
        self.client = Client(url=self.url)
        self.connecte = False

        self.NODE_BOUTEILLE = 'ns=3;s="DB_Vision"."presence_bouteille"'
        self.NODE_NIVEAU    = 'ns=3;s="DB_Vision"."niveau_liquide"'

    async def connecter(self):
        try:
            await self.client.connect()
            self.connecte = True
            logger.info("Connecte au PLC: {}".format(self.url))
        except Exception as e:
            self.connecte = False
            logger.error("Echec connexion PLC: {}".format(e))

    async def envoyer(self, bouteille_presente, niveau_pct):
        if not self.connecte:
            return
        try:
            node_b = self.client.get_node(self.NODE_BOUTEILLE)
            node_n = self.client.get_node(self.NODE_NIVEAU)
            
            # Utilisation de set_value au lieu de write_value pour l'automate Siemens
            await node_b.set_value(bool(bouteille_presente))
            await node_n.set_value(float(niveau_pct))
            
            logger.info("Envoye -> bouteille: {} | niveau: {:.1f}%".format(
                bouteille_presente, niveau_pct))
        except Exception as e:
            logger.error("Erreur envoi PLC: {}".format(e))
            self.connecte = False

    async def deconnecter(self):
        if self.connecte:
            await self.client.disconnect()
            logger.info("Deconnecte du PLC")


async def test_standalone():
    """Sends fake values to PLC in real time — no camera needed"""
    import time

    logging.basicConfig(level=logging.INFO,
                        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')

    plc = CommunicateurPLC(ip=", port=4840)
    await plc.connecter()

    if not plc.connecte:
        print("Impossible de se connecter au PLC. Verifiez IP et PLCSim.")
        return

    print("Connexion OK — envoi de valeurs simulees...")
    print("Ctrl+C pour arreter\n")

    niveau = 0.0
    bouteille = True

    try:
        while True:
            # Simulate filling cycle
            if bouteille:
                niveau = min(niveau + 1.5, 100.0)
                if niveau >= 100.0:
                    print("Bouteille pleine — simulation retrait bouteille")
                    bouteille = False
                    niveau = 0.0
            else:
                # Simulate 3 seconds with no bottle then new bottle arrives
                await asyncio.sleep(3)
                bouteille = True
                print("Nouvelle bouteille — reprise remplissage")

            await plc.envoyer(bouteille, niveau)
            print("bouteille={} | niveau={:.1f}%".format(bouteille, niveau))
            await asyncio.sleep(0.5)

    except KeyboardInterrupt:
        print("\nArret demande")
    finally:
        await plc.deconnecter()


if __name__ == "__main__":
    loop = asyncio.get_event_loop()
    loop.run_until_complete(test_standalone())
    loop.close()
